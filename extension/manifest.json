{
  "manifest_version": 3,
  "name": "ExamGuard AI — Examination Security & Session Integrity",
  "version": "1.0.0",
  "description": "Monitors disclosed and permitted session focus, window blurring, and multi-tab anomalies for ExamGuard AI examinations.",
  "permissions": [
    "activeTab",
    "storage",
    "tabs"
  ],
  "host_permissions": [
    "http://localhost:5173/*",
    "http://localhost:5000/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://localhost:5173/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "ExamGuard AI Security Agent"
  },
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
